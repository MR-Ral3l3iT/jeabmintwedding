{
  "name": "wedding-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "prisma:generate": "npm run generate --workspace=packages/prisma",
    "prisma:migrate:dev": "npm run migrate:dev --workspace=packages/prisma",
    "prisma:migrate:deploy": "npm run migrate:deploy --workspace=packages/prisma",
    "prisma:seed": "npm run seed --workspace=packages/prisma",
    "prisma:studio": "npm run studio --workspace=packages/prisma",
    "db:setup": "psql -h localhost -U $USER -d postgres -f scripts/setup-local-db.sql",
    "line:richmenu": "node scripts/setup-richmenu.mjs",
    "line:richmenu:list": "node scripts/setup-richmenu.mjs --list",
    "line:richmenu:preview": "python3 scripts/measure-richmenu.py docs/assets/richmenu-jm-wedding.png --overlay docs/assets/richmenu-areas-preview.png"
  }
}
