generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ประเภทแขกที่แอดมินกำหนดเองได้
model GuestCategory {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  guests        Guest[]
  seatingGroups SeatingGroup[]

  @@index([sortOrder])
  @@map("guest_categories")
}

enum PartySide {
  GROOM
  BRIDE
}

enum InviteLocale {
  TH
  EN
}

/// รายชื่อแขก — สร้างจากหลังบ้าน (เชิญ) หรือตอบ RSVP โดยตรง
model Guest {
  id            String         @id @default(cuid())
  displayName   String?        @db.VarChar(150)
  name          String?        @db.VarChar(100)
  categoryId    String?        @map("category_id")
  partySide     PartySide?     @map("party_side")
  locale        InviteLocale   @default(TH)
  attending     Boolean?
  attendeeCount Int?
  inviteToken   String?        @unique @db.VarChar(32)
  rsvpAt        DateTime?
  lineUserId    String?        @unique @db.VarChar(100)
  createdAt     DateTime       @default(now())

  category       GuestCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  wish           Wish?
  lineFriend     LineFriend?
  seatingTable   SeatingTableGuest?

  @@index([attending])
  @@index([categoryId])
  @@index([partySide])
  @@index([createdAt])
  @@index([displayName])
  @@map("guests")
}

/// คนที่เพิ่มเพื่อน LINE OA (เก็บก่อน แล้วค่อยผูกกับ Guest)
model LineFriend {
  id          String    @id @default(cuid())
  lineUserId  String    @unique @map("line_user_id") @db.VarChar(100)
  displayName String?   @map("display_name") @db.VarChar(150)
  pictureUrl  String?   @map("picture_url") @db.VarChar(500)
  followedAt  DateTime  @default(now()) @map("followed_at")
  unfollowedAt DateTime? @map("unfollowed_at")
  guestId     String?   @unique @map("guest_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  guest Guest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([followedAt])
  @@index([unfollowedAt])
  @@map("line_friends")
}

/// คำอวยพรจากแขก
model Wish {
  id        String   @id @default(cuid())
  message   String   @db.Text
  guestId   String   @unique
  createdAt DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("wishes")
}

/// Admin สำหรับเจ้าบ่าว-เจ้าสาว
model Admin {
  id           String @id @default(cuid())
  email        String @unique @db.VarChar(255)
  passwordHash String

  @@map("admins")
}

/// ข้อมูลงานแต่ง (แถวเดียว id = default)
model WeddingSettings {
  id                String   @id @default("default")
  groomName         String   @db.VarChar(150)
  groomNickname     String   @db.VarChar(50)
  brideName         String   @db.VarChar(150)
  brideNickname     String   @db.VarChar(50)
  weddingDate       DateTime
  venue             String   @db.VarChar(200)
  city              String   @db.VarChar(200)
  lineOaId          String   @db.VarChar(100)
  lineOaUrl         String   @db.VarChar(500)
  rsvpContactPhone  String   @db.VarChar(30)
  mapsUrl           String   @db.VarChar(500)
  rsvpDeadline      DateTime
  promptpay         String?  @db.VarChar(30)
  promptpayName     String?  @db.VarChar(150)
  bankName          String?  @db.VarChar(100)
  bankAccountNumber String?  @db.VarChar(50)
  bankAccountName   String?  @db.VarChar(150)
  paymentQrUrl      String?  @db.VarChar(500)
  timeline          Json     @default("[]")
  groomBio          String?  @map("groom_bio") @db.Text
  brideBio          String?  @map("bride_bio") @db.Text
  botKnowledge      String?  @map("bot_knowledge") @db.Text
  updatedAt         DateTime @updatedAt

  @@map("wedding_settings")
}

/// บุคลิกบอท LINE (แก้ได้ที่ Bot Studio เท่านั้น)
model BotPersona {
  id           String   @id @default("default")
  displayName  String   @map("display_name") @db.VarChar(100)
  selfCallName String   @map("self_call_name") @db.VarChar(50)
  tone         String   @db.Text
  languageNote String   @map("language_note") @db.Text
  emojiPolicy  String   @map("emoji_policy") @db.Text
  maxLength    Int      @default(500) @map("max_length")
  doNotDo      String   @map("do_not_do") @db.Text
  whenUnknown  String   @map("when_unknown") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("bot_personas")
}

/// ประวัติการคุยกับบอท — หนึ่งแถวต่อหนึ่ง LINE user, หมดอายุตามเวลาที่เงียบไป
model BotConversation {
  id            String    @id @default(cuid())
  lineUserId    String    @unique @map("line_user_id") @db.VarChar(100)
  /// [{ role: 'user' | 'model', text: string }] เก็บเฉพาะรอบล่าสุด
  messages      Json      @default("[]")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  /// ครั้งสุดท้ายที่ส่งคำแนะนำวิธีคุยให้ — กันไม่ให้ส่งซ้ำทุกข้อความ
  hintedAt      DateTime? @map("hinted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([lastMessageAt])
  @@map("bot_conversations")
}

/// หัวข้อความรู้บอท (เพิ่ม/ลบได้ที่ Bot Studio)
model BotKnowledgeTopic {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  body      String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("bot_knowledge_topics")
}

/// บันทึกการใช้ Gemini / snapshot อื่นๆ
model BotUsageLog {
  id               String   @id @default(cuid())
  provider         String   @db.VarChar(30)
  kind             String   @db.VarChar(50)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  meta             Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@map("bot_usage_logs")
}

enum SeatingSpotKind {
  TABLE
  FACILITY
}

/// โต๊ะ / จุดบนผังงาน (seed จาก docs/ผังงาน.pptx)
model SeatingTable {
  id             String          @id @default(cuid())
  code           String          @unique @db.VarChar(20)
  kind           SeatingSpotKind @default(TABLE)
  label          String?         @db.VarChar(100)
  xPercent       Float           @map("x_percent")
  yPercent       Float           @map("y_percent")
  widthPercent   Float           @map("width_percent")
  heightPercent  Float           @map("height_percent")
  groupId        String?         @map("group_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  group  SeatingGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  guests SeatingTableGuest[]

  @@index([kind])
  @@index([groupId])
  @@map("seating_tables")
}

/// กลุ่มป้ายโต๊ะ — ผูกประเภทการ์ด หรือชื่อกำหนดเอง
model SeatingGroup {
  id              String   @id @default(cuid())
  guestCategoryId String?  @unique @map("guest_category_id")
  customName      String?  @map("custom_name") @db.VarChar(100)
  shortName       String   @map("short_name") @db.VarChar(20)
  color           String   @default("#6b7c5e") @db.VarChar(20)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  guestCategory GuestCategory? @relation(fields: [guestCategoryId], references: [id], onDelete: Cascade)
  tables        SeatingTable[]

  @@index([sortOrder])
  @@map("seating_groups")
}

/// แขกที่ระบุโต๊ะไว้เป็นรายชื่อ (หนึ่งคนหนึ่งโต๊ะ)
model SeatingTableGuest {
  id        String   @id @default(cuid())
  tableId   String   @map("table_id")
  guestId   String   @unique @map("guest_id")
  createdAt DateTime @default(now()) @map("created_at")

  table SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("seating_table_guests")
}
